# Postgres
POSTGRES_USER=metronome
POSTGRES_PASSWORD=metronome
POSTGRES_DB=metronome
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://metronome:metronome@localhost:5432/metronome
# Set to true for hosted Postgres (Supabase, etc.) that requires SSL - leave
# false for local Docker Postgres.
DATABASE_SSL=false
# Comma-separated (not JSON) - easier to paste into a hosting dashboard.
CORS_ORIGINS=http://localhost:5173
# Free key from https://developer.ticketmaster.com - powers event_density.
# Falls back to a mock value if left blank.
TICKETMASTER_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
